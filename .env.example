TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
ADMIN_CHAT_ID=
FREE_SHIPPING_MIN=100
DEFAULT_SHIPPING=14
DATA_DIR=data
PRODUCTS_CSV=Product_export.csv
B2B_DISCOUNT=15
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=eur
FOLLOWUP_HOURS=24

# ── Pagamenti Revolut (Merchant API) ──────────────────────────────
# Chiave pubblica (client, RevolutCheckout) e segreta (server, crea ordini).
REVOLUT_PUBLIC_API=
REVOLUT_SECRET_API=
# "sandbox" per i test, "prod" quando sei pronto a incassare davvero.
REVOLUT_MODE=sandbox
# REVOLUT_API_VERSION=2024-09-01

# ── PayPal (pagamento manuale all'email del negozio) ──────────────
# Email PayPal su cui ricevere i pagamenti; il bot invia al cliente le
# istruzioni per pagare a questo indirizzo quando sceglie PayPal.
PAYPAL_EMAIL=
# Link PayPal.me opzionale (es. paypal.me/tuonome): genera un link con importo.
PAYPAL_ME=

# URL HTTPS della Mini App.
# IMPORTANTE: per ordini/pagamenti/profili la Mini App DEVE essere servita
# da questo stesso servizio (l'API sta su /api). Su Railway lascialo VUOTO:
# viene ricavato da RAILWAY_PUBLIC_DOMAIN. GitHub Pages NON ha l'API, quindi
# non supporta il checkout: usalo solo come vetrina statica.
WEBAPP_URL=
# PORT è iniettata da Railway; in locale impostala per servire la Mini App
# (es. PORT=8080 → http://localhost:8080). Se assente, il bot fa solo polling.
# PORT=8080
